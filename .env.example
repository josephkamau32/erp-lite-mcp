ADMIN_API_KEY=your_secret_admin_key_here
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp_lite
# DATABASE_URL is set automatically by docker-compose.yml (points to the db service).
# Only set it here if running outside Docker, e.g.: postgresql://erp_user:erp_password@localhost:15432/erp_lite
